# URL do backend. Sem isto, o front assume http://localhost:8000.
VITE_API_URL=http://localhost:8000

# Telemetria. Sem esta variável o SDK não é inicializado e nada é enviado —
# o aplicativo funciona igual, e os erros vão para o console do navegador.
# VITE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
