# URL do backend. Sem isto, o front assume http://localhost:8001.
#
# 8001 e nao 8000: a 8000 esta ocupada por outro produto na maquina de
# desenvolvimento, e ele responde — o sintoma de apontar para la e "nao foi
# possivel entrar", que parece backend fora do ar.
VITE_API_URL=http://localhost:8001

# Telemetria. Sem esta variável o SDK não é inicializado e nada é enviado —
# o aplicativo funciona igual, e os erros vão para o console do navegador.
# VITE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
